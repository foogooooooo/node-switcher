{
  "name": "node-switcher",
  "version": "0.1.0-alpha.1",
  "description": "Local desktop routing editor for Mihomo and Clash Verge Rev",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Node Switcher contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:core": "node scripts/test-mihomo.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "pack": "node scripts/package.mjs",
    "dist:mac": "node scripts/package.mjs --zip",
    "demo": "electron . --demo"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.9.0"
  }
}
